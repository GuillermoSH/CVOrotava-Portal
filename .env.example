# Copy to `.env.local` and fill from Supabase project settings (never commit `.env.local`).

# Public — safe to expose in browser bundle
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional — solo para dev en móvil/LAN con `pnpm dev:mobile`. Comenta si usas localhost.
# NEXT_PUBLIC_SITE_URL=http://192.168.x.x:3000

# Server-only — never use in Client Components or `NEXT_PUBLIC_*`
SUPABASE_SERVICE_ROLE_KEY=

# Opcional — conexión Postgres directa (pooler) para `pnpm clothing:test-db` y migraciones locales
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Opcional — avisos por correo (p. ej. Resend) desde el servidor
# RESEND_API_KEY=

# Solo desarrollo local — omitir login (rol admin por defecto). Nunca en producción.
# DEV_AUTH_BYPASS=true
# DEV_AUTH_BYPASS_ROLE=admin
